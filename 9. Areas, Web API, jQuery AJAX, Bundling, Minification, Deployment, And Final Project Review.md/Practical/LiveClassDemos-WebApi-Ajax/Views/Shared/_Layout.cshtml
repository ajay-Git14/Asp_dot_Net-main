<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LiveClassDemos</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a asp-controller="AjaxDemo" asp-action="Index" class="brand">LiveClassDemos</a>
            <a asp-controller="AjaxDemo" asp-action="Index">AJAX Demo</a>
            <a href="/api/complaints" target="_blank">Complaints API</a>
            <a href="/api/dashboard/summary" target="_blank">Dashboard API</a>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
