<form asp-action="CreateManual" method="post" enctype="multipart/form-data">

    <label>Name</label>
    <input name="Name" />

    <br /><br />

    <label>Email</label>
    <input name="Email" />

    <br /><br />

    <label>Course</label>
    <select name="Course">
        <option>ASP.NET Core MVC</option>
        <option>React</option>
        <option>PHP</option>
    </select>

    <br /><br />

    <label>Age</label>
    <input name="Age" />

    <br /><br />

    <label>ImagePath</label>
    <input type="file" name="ImageFile" />

    <br /><br />

    <button type="submit">Submit</button>

</form>