@{
    ViewData["Title"] = "Create Complaint";
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
    {
        Title = "Create Complaint",
        Subtitle = "This placeholder uses the same layout and shared page header partial.",
        ActionText = "Back to Complaints",
        ActionController = "Complaints",
        ActionName = "Index"
    })
}

<div class="alert alert-secondary">
    Form model binding, validation, and POST handling will be added in the upcoming MVC forms module.
</div>

<form method="post" asp-controller="Complaints" asp-action="Create">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="title">Title</label>
            <input class="form-control" id="title" name="title" placeholder="Example: Lift not working" />
        </div>

        <div class="col-md-6">
            <label class="form-label" for="category">Category</label>
            <select class="form-select" id="category" name="category">
                <option>Maintenance</option>
                <option>Plumbing</option>
                <option>Electrical</option>
                <option>Housekeeping</option>
            </select>
        </div>

        <div class="col-12">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4"></textarea>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary" type="submit" disabled>Submit Later</button>
        <a class="btn btn-outline-secondary" asp-controller="Complaints" asp-action="Index">Cancel</a>
    </div>
</form>
