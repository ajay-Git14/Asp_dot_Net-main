@model ComplaintSummaryViewModel

<div class="complaint-card">
    <div class="d-flex justify-content-between gap-3">
        <div>
            <div class="small text-muted">@Model.ReferenceNumber</div>
            <h3 class="h5 mb-1">@Model.Title</h3>
            <p class="text-muted mb-2">@Model.Description</p>
        </div>

        <div class="text-end">
            @await Html.PartialAsync("_StatusBadge", Model.Status)
        </div>
    </div>

    <div class="complaint-meta">
        <span>Category: <strong>@Model.Category</strong></span>
        <span>Priority: @await Html.PartialAsync("_PriorityBadge", Model.Priority)</span>
        <span>Created: <strong>@Model.CreatedOn.ToString("dd-MMM-yyyy")</strong></span>
    </div>

    <div class="mt-3">
        <a class="btn btn-sm btn-outline-primary"
           asp-controller="Complaints"
           asp-action="Details"
           asp-route-id="@Model.Id">
            View Details
        </a>
    </div>
</div>
