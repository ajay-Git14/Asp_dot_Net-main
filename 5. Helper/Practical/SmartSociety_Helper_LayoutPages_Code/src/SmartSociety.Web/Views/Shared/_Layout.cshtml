<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Society</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_TopNavigation")

    <div class="app-shell">
        @await Html.PartialAsync("_SideNavigation")

        <main class="app-main">
            @if (IsSectionDefined("PageHeader"))
            {
                @await RenderSectionAsync("PageHeader", required: false)
            }
            else if (ViewData["Title"] is not null)
            {
                <div class="page-header">
                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">Smart Society MVC page</p>
                    </div>
                </div>
            }

            <div class="content-card">
                @RenderBody()
            </div>

            @await Html.PartialAsync("_Footer")
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
