@model ComplaintIndexViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

@section PageHeader {
    @await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
    {
        Title = Model.PageTitle,
        Subtitle = Model.PageSubtitle,
        ActionText = "Create Complaint",
        ActionController = "Complaints",
        ActionName = "Create"
    })
}

<div class="filter-bar mb-4">
    <span class="fw-semibold">Filter:</span>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Complaints" asp-action="Index">All</a>
    <a class="btn btn-sm btn-outline-warning" asp-controller="Complaints" asp-action="Index" asp-route-status="Open">Open</a>
    <a class="btn btn-sm btn-outline-info" asp-controller="Complaints" asp-action="Index" asp-route-status="Assigned">Assigned</a>
    <a class="btn btn-sm btn-outline-success" asp-controller="Complaints" asp-action="Index" asp-route-status="Resolved">Resolved</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SelectedStatus))
{
    <div class="alert alert-info">
        Showing complaints with status: <strong>@Model.SelectedStatus</strong>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card small-metric">
            <span>Total</span>
            <strong>@Model.TotalComplaints</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card small-metric">
            <span>Open</span>
            <strong>@Model.OpenComplaints</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card small-metric">
            <span>Resolved</span>
            <strong>@Model.ResolvedComplaints</strong>
        </div>
    </div>
</div>

@if (!Model.Complaints.Any())
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = "No complaints found",
        Message = "Change the filter or create a new complaint.",
        ActionText = "Create Complaint",
        ActionController = "Complaints",
        ActionName = "Create"
    })
}
else
{
    <div class="vstack gap-3">
        @foreach (var complaint in Model.Complaints)
        {
            @await Html.PartialAsync("_ComplaintSummaryCard", complaint)
        }
    </div>
}
