@model CreateProductViewModel
@{
    ViewData["Title"] = "Create product";
}

<section class="form-card">
    <p class="eyebrow">GET displays, POST processes</p>
    <h1>Create product</h1>
    <p>
        Opening this page selects the <code>[HttpGet]</code> action.
        Submitting the form selects the <code>[HttpPost]</code> action.
    </p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="validation"></span>
        </div>

        <div class="checkbox-row">
            <input asp-for="IsFeatured" />
            <label asp-for="IsFeatured"></label>
        </div>

        <div class="button-row">
            <button class="button primary" type="submit">Create product</button>
            <a class="button" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
